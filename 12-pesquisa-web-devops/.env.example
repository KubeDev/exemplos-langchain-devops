# Copie para .env e preencha — o .env está no .gitignore e nunca deve ser commitado.
ANTHROPIC_API_KEY=sua-chave-aqui

# Chaves das ferramentas prontas. As duas têm camada gratuita, sem cartão.
# Tavily: https://app.tavily.com · Firecrawl: https://www.firecrawl.dev/app/api-keys
TAVILY_API_KEY=sua-chave-aqui
FIRECRAWL_API_KEY=sua-chave-aqui

# Identificador do modelo usado pelo ChatAnthropic.
MODELO=claude-sonnet-5
