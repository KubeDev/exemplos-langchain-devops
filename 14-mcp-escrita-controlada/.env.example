# Copie para .env e preencha — o .env está no .gitignore e nunca deve ser commitado.
ANTHROPIC_API_KEY=sua-chave-aqui

# Identificador do modelo usado pelo ChatAnthropic.
MODELO=claude-sonnet-5

# Token do DigitalOcean só de leitura (droplet:read).
# Lido pelo server na ferramenta listar_droplets.
DIGITALOCEAN_TOKEN=seu-token-de-leitura-aqui

# Token do DigitalOcean de escrita (droplet:read e droplet:update).
# Lido pelo server só na ferramenta desligar_droplet.
DIGITALOCEAN_TOKEN_ESCRITA=seu-token-de-escrita-aqui
