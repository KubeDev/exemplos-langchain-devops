# Copie para .env e preencha. O .env está no .gitignore e nunca deve ser commitado.
ANTHROPIC_API_KEY=sua-chave-aqui

# Identificador do modelo usado pelo ChatAnthropic.
MODELO=claude-sonnet-5

# Endpoint Streamable HTTP do MCP server da DigitalOcean.
# O token da DigitalOcean fica no server, não no agente.
MCP_URL=http://localhost:8000/mcp

# Token dos scripts de setup/: cria e apaga os Droplets do laboratório.
# Não é usado pelo agente.
DIGITALOCEAN_TOKEN_SETUP=seu-token-de-setup
