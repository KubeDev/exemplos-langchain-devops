# Copie para .env e preencha. O .env está no .gitignore e nunca deve ser commitado.
ANTHROPIC_API_KEY=sua-chave-aqui

# Identificador do modelo usado pelo ChatAnthropic.
MODELO=claude-sonnet-5

# Token do exemplo: escopo customizado com droplet:read e monitoring:read.
# O monitoring:read é o que a verificar_saude acrescenta ao token do 09.
DIGITALOCEAN_TOKEN=seu-token-somente-leitura

# Token dos scripts de setup/: cria e apaga Droplets. Não é usado pelo agente.
DIGITALOCEAN_TOKEN_SETUP=seu-token-de-setup
