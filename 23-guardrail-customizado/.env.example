# Copie para .env e preencha. O .env está no .gitignore e nunca deve ser commitado.
ANTHROPIC_API_KEY=sua-chave-aqui

# Identificador do modelo usado pelo ChatAnthropic.
MODELO=claude-haiku-5-5

# Arquivo com a flag da janela de manutenção: "aberta" ou "fechada".
# Lido a cada chamada de ferramenta: editar o arquivo vale sem reiniciar o app.
ARQUIVO_MANUTENCAO=manutencao.txt
