# Copie para .env e preencha — o .env está no .gitignore e nunca deve ser commitado.
ANTHROPIC_API_KEY=sua-chave-aqui

# Identificador do modelo usado pelo ChatAnthropic.
MODELO=claude-sonnet-5

# Credencial e região da AWS vêm da configuração padrão do boto3.
# AWS_PROFILE é o NOME de um perfil do ~/.aws/config (o que aparece entre colchetes,
# como default), não o caminho do arquivo. Sem a linha, o boto3 usa o perfil default.
AWS_PROFILE=default
AWS_REGION=us-east-1
