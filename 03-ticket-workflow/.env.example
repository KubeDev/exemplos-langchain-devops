# Copie para .env e preencha — o .env esta no .gitignore e nunca deve ser commitado.
ANTHROPIC_API_KEY=sua-chave-aqui

# Limiar de confianca do classificador. Abaixo disso o alerta vai para
# fan-out (os dois especialistas), mesmo que a categoria nao seja "ambos".
LIMIAR_CONFIANCA=0.7

# 1 = log detalhado (payload normalizado + schemas retornados)
# 0 = so a narrativa do fluxo
LOG_VERBOSE=1
