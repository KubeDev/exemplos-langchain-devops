###############################################################################
#  ROTEIRO DA AULA — LangChain: chains com LCEL (prompt | modelo | parser)
#
#  Os cenarios estao na ORDEM DA APRESENTACAO. Rode um de cada vez e leia o
#  log antes de passar ao proximo.
#
#  Antes de comecar:  uv sync  &&  uv run uvicorn src.main:app --reload
#
#  Os mesmos payloads estao em exemplos/*.json para reexecucao via curl.
#  Aqui estao inline de proposito: durante a aula voce quer o payload e o
#  resultado na mesma tela.
###############################################################################

@host = http://localhost:8000


###############################################################################
# 1 · INFRA — o primeiro ramo do roteamento
#
# O QUE MOSTRAR: a chain escolhendo UM caminho.
# ESPERADO: 1 arquivo em tickets/infra/ · nenhum em tickets/desenvolvimento/
# NO LOG: a resposta crua da triagem e a categoria normalizada.
#
# Disco cheio no no do cluster: os logs sao todos do kubelet e do containerd,
# nao ha nada de codigo de aplicacao aqui.
###############################################################################
POST {{host}}/webhook/alerta
Content-Type: application/json

{
  "titulo": "Disco do no ip-10-0-3-42 acima de 98% de uso",
  "servico": "kubernetes-node-pool-a",
  "severidade": "critical",
  "metricas": {
    "node": "ip-10-0-3-42.ec2.internal",
    "mountpoint": "/var/lib/containerd",
    "espaco_disponivel": "1.8%",
    "cpu": "31%",
    "memoria": "44%"
  },
  "logs": [
    "kubelet: eviction manager: attempting to reclaim ephemeral-storage",
    "kubelet: failed to garbage collect required amount of images. Wanted to free 8589934592 bytes, but freed 214748364 bytes",
    "containerd: failed to create shim task: no space left on device",
    "kubelet: Evicted pod checkout-api-7d9f8b-x2klm due to DiskPressure"
  ]
}


###############################################################################
# 2 · DESENVOLVIMENTO — o segundo ramo
#
# O QUE MOSTRAR: as chains sao exatamente as mesmas do cenario 1. Mudou o
#                dado, mudou a classificacao, e o ramo tomado mudou junto.
# ESPERADO: 1 arquivo em tickets/desenvolvimento/
#
# NullPointerException minutos depois de um deploy, com CPU e memoria calmas.
# Compare com o cenario 1: aqui a evidencia e stack trace, nao metrica de no.
###############################################################################
POST {{host}}/webhook/alerta
Content-Type: application/json

{
  "titulo": "Taxa de erro 5xx em checkout-api subiu para 34% apos deploy",
  "servico": "checkout-api",
  "severidade": "critical",
  "metricas": {
    "taxa_erro": "34%",
    "taxa_erro_baseline": "0.2%",
    "deploy_recente": "v2.14.0 ha 6 minutos",
    "cpu": "23%",
    "memoria": "41%"
  },
  "logs": [
    "ERROR c.l.checkout.PaymentHandler - Unhandled exception processing order 88213",
    "java.lang.NullPointerException: Cannot invoke \"CouponDTO.getDiscount()\" because \"coupon\" is null",
    "  at com.loja.checkout.PaymentHandler.applyDiscount(PaymentHandler.java:142)",
    "  at com.loja.checkout.PaymentHandler.process(PaymentHandler.java:87)",
    "WARN  c.l.checkout.CouponClient - coupon-service returned 200 with empty body for code SEMDESCONTO",
    "INFO  deploy - rollout v2.14.0 completed, 12/12 pods ready, cpu e memoria estaveis"
  ]
}


###############################################################################
# 3 · AMBIGUO — os dois especialistas analisam o mesmo alerta
#
# O QUE MOSTRAR: a triagem devolve `ambos`, e o `if` do fluxo chama os dois
#                especialistas com o MESMO texto de alerta.
# ESPERADO: 2 arquivos, um em tickets/infra/ e outro em tickets/desenvolvimento/
#
# A COMPARACAO QUE IMPORTA: os dois recebem exatamente o mesmo texto. A
# diferenca entre os relatorios vem so da lente de cada system prompt.
#
# OOMKilled classico: o limite foi cortado de 1Gi para 512Mi (infra) ou o
# codigo carrega 41 mil registros em memoria (dev)? Os dois relatorios vao
# discordar — e essa discordancia e o produto, nao o defeito.
###############################################################################
POST {{host}}/webhook/alerta
Content-Type: application/json

{
  "titulo": "Pods do servico relatorios reiniciando em loop por OOMKilled",
  "servico": "relatorios-api",
  "severidade": "high",
  "metricas": {
    "reinicios_ultima_hora": 14,
    "memory_limit_atual": "512Mi",
    "memory_limit_anterior": "1Gi",
    "memory_usage_pico": "511Mi",
    "memoria_media_7d": "180Mi",
    "volume_requisicoes": "estavel, sem aumento"
  },
  "logs": [
    "kubelet: Memory cgroup out of memory: Killed process 1 (java) total-vm:2841232kB, anon-rss:523904kB",
    "State: Terminated, Reason: OOMKilled, Exit Code: 137",
    "platform-audit: LimitRange 'rightsizing-q3' aplicado ha 3 dias reduziu memory limit de relatorios-api de 1Gi para 512Mi",
    "platform-audit: outros 2 servicos do mesmo namespace tiveram limite reduzido no mesmo lote e nao apresentaram OOM",
    "INFO  c.l.relatorios.ExportService - iniciando exportacao consolidada, 41200 registros",
    "WARN  c.l.relatorios.ExportService - carregando resultado completo em memoria antes de serializar",
    "GC overhead: 6 full GCs nos ultimos 90 segundos, heap after GC subindo a cada ciclo"
  ]
}


###############################################################################
# 4 · PAYLOAD VAGO — sem informacao, os dois seguem candidatos
#
# O QUE MOSTRAR: o mesmo caminho do cenario 3, por um motivo diferente. La
#                havia evidencia dos dois lados; aqui nao ha evidencia
#                nenhuma — e "nao sei" tambem significa investigar os dois.
# ESPERADO: 2 arquivos, e na secao "## Evidencia" de cada um a frase
#           "Nenhuma evidencia direta no alerta". E o anti-alucinacao dos
#           prompts funcionando: sem log, o modelo tem de admitir que esta
#           levantando hipotese em vez de inventar uma causa raiz.
###############################################################################
POST {{host}}/webhook/alerta
Content-Type: application/json

{
  "titulo": "Alguma coisa errada com o sistema de pagamentos",
  "servico": "pagamentos",
  "severidade": "warning"
}


###############################################################################
# saude — util so para confirmar que o servidor subiu
###############################################################################
GET {{host}}/saude
